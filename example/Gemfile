source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version.
# Ruby 3.1 is the floor required by the patched Active Support releases below.
ruby ">= 3.1.0"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
# 7.2.3.1 is the first release patched against the ReDoS, DoS and SafeBuffer#%
# advisories; the 6.1, 7.0 and 7.1 lines received no backport.
gem 'activesupport', '>= 7.2.3.1'
gem 'xcodeproj', '< 1.26.0'
# 1.3.7 fixes the AtomicReference livelock and both ReadWriteLock advisories.
# The upstream '< 1.3.4' pin worked around 1.3.5 dropping its logger
# dependency, which the explicit 'logger' gem below already covers.
gem 'concurrent-ruby', '>= 1.3.7'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
